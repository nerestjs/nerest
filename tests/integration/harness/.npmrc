; Install the local @nerest/nerest (a file: dependency) as a real, copied
; package rather than a symlink. This makes npm resolve nerest's own
; dependencies (e.g. @fastify/*) from nerest's package.json into the harness
; tree — exactly as a published consumer would — and keeps a single React
; instance for SSR. See package.json "@nerest/nerest": "file:../../..".
install-links=true
