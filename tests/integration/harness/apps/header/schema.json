{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "HeaderProps",
  "description": "Renders website's header with countdown",
  "type": "object",
  "properties": {
    "countdownSeconds": { "type": "number" },
    "affirmation": { "type": "string" },
    "xssProp": {
      "type": "string",
      "description": "Arbitrary untrusted text used to verify XSS protection. May contain HTML-significant characters and sequences such as '<', '>', '&'"
    }
  },
  "required": ["countdownSeconds"]
}
